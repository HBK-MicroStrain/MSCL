@PACKAGE_INIT@

# Include the correct library by architecture
if(CMAKE_SIZEOF_VOID_P EQUAL 4)
    include("${CMAKE_CURRENT_LIST_DIR}/x86/@PACKAGE_NAME@-targets.cmake")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/x64/@PACKAGE_NAME@-targets.cmake")
endif()

# Create an alias for the target library
add_library(@LIBRARY_NAME_ALIAS@ ALIAS @PACKAGE_NAMESPACE@::@LIBRARY_NAME@)
@ADDITIONAL_LIBRARY_ALIAS@

# Setup the library variable
set(@LIBRARY_NAME_UPPER@_LIBRARY @PACKAGE_NAMESPACE@::@LIBRARY_NAME_ALIAS@)
set(@LIBRARY_NAME_UPPER@_LIBRARIES ${@LIBRARY_NAME_UPPER@_LIBRARY})

# Setup the include directories
# Note: CMake 3.23+ automatically re-contributes the target's HEADERS file set
#       base directories to INTERFACE_INCLUDE_DIRECTORIES, which duplicates the
#       entry already present here. Dedupe before validating with set_and_check,
#       which requires exactly one path.
get_target_property(@LIBRARY_NAME_UPPER@_INCLUDE_DIR @LIBRARY_NAME_ALIAS@ INTERFACE_INCLUDE_DIRECTORIES)
list(REMOVE_DUPLICATES @LIBRARY_NAME_UPPER@_INCLUDE_DIR)
set_and_check(@LIBRARY_NAME_UPPER@_INCLUDE_DIR ${@LIBRARY_NAME_UPPER@_INCLUDE_DIR})
set_and_check(@LIBRARY_NAME_UPPER@_INCLUDE_DIRS ${@LIBRARY_NAME_UPPER@_INCLUDE_DIR})

# Note: Consumers of MSCL need to use the precompiled header in their own project
#       (mscl/stdafx.h). This cannot be configured here via target_precompile_headers,
#       since CMake does not allow mutating build properties of an IMPORTED target
#       from outside the project that exports it. See the C++ Integration Guide
#       for the documented pattern consumers should use instead.

# Find/configure some dependencies
include(CMakeFindDependencyMacro)

# Find the proper linking version of Boost
set(Boost_USE_STATIC_LIBS @Boost_USE_STATIC_LIBS@)

# Boost is required for linking the pre-built library
find_dependency("Boost"
    @Boost_VERSION@ EXACT
    REQUIRED
    COMPONENTS @Boost_COMPILED_COMPONENTS@
    CONFIG
)

# Link Boost as a required dependency
# Note: target_link_libraries() cannot be used here since @LIBRARY_NAME_UPPER@_LIBRARY
#       resolves to an IMPORTED target not built by this project, and set_property()
#       cannot target the @LIBRARY_NAME_UPPER@_LIBRARY alias either (ALIAS targets
#       cannot have properties set on them at all). Target the real underlying
#       imported target instead.
set_property(TARGET @PACKAGE_NAMESPACE@::@LIBRARY_NAME@ APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES ${Boost_LIBRARIES}
)

# OpenSSL is required for linking if the pre-built library used it
if(@MSCL_WITH_SSL@)
    # OpenSSL doesn't clear its variables properly for recurring find_package calls
    # This variable needs to be cleared so OPENSSL_ROOT_DIR can then be used properly
    unset(OPENSSL_INCLUDE_DIR CACHE)

    # Find the proper linking version of OpenSSL
    set(OPENSSL_USE_STATIC_LIBS @OPENSSL_USE_STATIC_LIBS@)

    find_dependency("OpenSSL"
        @OPENSSL_VERSION@ EXACT
        REQUIRED
    )

    # Link OpenSSL as a required dependency
    # Note: see the Boost note above regarding why set_property() targets the real
    #       imported target instead of target_link_libraries() or the alias.
    set_property(TARGET @PACKAGE_NAMESPACE@::@LIBRARY_NAME@ APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "OpenSSL::SSL" "OpenSSL::Crypto"
    )
endif()

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(
    @LIBRARY_NAME_UPPER@
    REQUIRED_VARS
        @LIBRARY_NAME_UPPER@_LIBRARY
        @LIBRARY_NAME_UPPER@_INCLUDE_DIR
)
